# Live stream source for /live. Accepts any of:
#   - a YouTube URL or video id   e.g. https://www.youtube.com/watch?v=XXXXXXXXXXX
#   - an HLS playlist             e.g. https://cdn.example.com/live/stream.m3u8
#   - any embeddable player URL   (rendered in an iframe)
# Several URLs separated by spaces or commas act as fallbacks: when an HLS feed fails to load
# or stalls, the player switches to the next one (and retries them all after a short wait).
STREAM_URL=

# Optional label shown above the player
STREAM_TITLE=ICC Cricket World Cup — Live

# Optional: several channels with tabs on /live (takes priority over STREAM_URL)
# Each channel takes "url" or "urls" (a list of fallback feeds).
# STREAM_CHANNELS=[{"name":"Main feed","urls":["https://example.com/live.m3u8","https://backup.example.com/live.m3u8"]},{"name":"Highlights","url":"https://www.youtube.com/watch?v=XXXXXXXXXXX"}]
# With neither set, /live plays public HLS test streams.
